# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# derived from node_modules — regenerated by postinstall
/public/basis/

# generated KTX2 textures — regenerated by convert-textures script
public/assets/materials-ktx2/
.gstack/
gate-screenshots/

# dev-server log — transient runtime output
.dev-server.log

# Transient gate/QA artifacts — only the committed baseline-*.png files
# in gate-baselines/ are versioned; everything else (recorded webm tours,
# qa-deep timestamped runs, vframes/tour-debug debug captures) is a
# one-shot output and stays out of git.
gate-baselines/*
!gate-baselines/baseline-*.png

# Output of scripts/verify-stack-bug-fix.mjs — regenerable visual evidence,
# not source. Run the script to recreate.
verify-stack-bug-fix/
verify-stack-bug-fix-BEFORE/
verify-stack-bug-fix-AFTER/

# Local QA scratch — visual-qa screenshots taken during development
.qa/
